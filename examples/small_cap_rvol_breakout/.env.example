# Required for crewai run (pick one provider)
OPENAI_API_KEY=your_key_here

# Optional overrides
# MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=

# --- Alpaca PAPER trading ---
# Create keys at https://app.alpaca.markets (Paper account)
ALPACA_API_KEY=your_paper_key
ALPACA_API_SECRET=your_paper_secret
ALPACA_PAPER=true
ALPACA_DRY_RUN=false
ALPACA_DATA_FEED=iex
ALPACA_POLL_SECONDS=15
ALPACA_MAX_OPEN_POSITIONS=3
ALPACA_ACCOUNT_EQUITY=25000
ALPACA_RISK_PER_TRADE_PCT=0.5
ALPACA_OR_MINUTES=5
ALPACA_MAX_PRICE=20
ALPACA_MIN_RVOL=2.0
ALPACA_MIN_ATR_PCT=3.0
# Optional comma-separated universe override:
# ALPACA_UNIVERSE=PLUG,OPEN,CLOV,ONDS,MARA,BBAI
